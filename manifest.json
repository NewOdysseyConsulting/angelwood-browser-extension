{
  "manifest_version": 3,
  "name": "Angelwood: Add Task from Page",
  "short_name": "Angelwood",
  "version": "1.0.0",
  "description": "Turn the page you are on into a task in one of your Angelwood projects, with the page title and link filled in.",
  "homepage_url": "https://angelwood.io",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Add this page as an Angelwood task",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://angelwood-api-uzil.onrender.com/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "add-task@angelwood.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo", "websiteContent", "browsingActivity"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
